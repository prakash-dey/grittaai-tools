# Password your team uses to sign in. Change this before deploying.
APP_PASSWORD=change-me

# Long random string used to sign the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Local SQLite file by default. For Vercel or other serverless hosts, use a Turso database:
#   DATABASE_URL=libsql://your-db-name.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/gritta.db
DATABASE_AUTH_TOKEN=
